#!/bin/sh
# sommerflusswm default autostart — a functional, impersonal baseline.
#
# Installed at /usr/share/sommerflusswm/autostart and used whenever
# ~/.config/sommerflusswm/autostart doesn't exist. Copy it there to customize:
#   mkdir -p ~/.config/sommerflusswm
#   cp /usr/share/sommerflusswm/autostart ~/.config/sommerflusswm/
#
# It aims to show what sfwm can do (native launcher, bar + tray, gestures,
# screenshots, notifications, wallpaper) without imposing program choices —
# see examples/personal/ in the source tree for fuller real-world setups.

Mod=Super
S=/usr/share/sommerflusswm   # packaged helper scripts
sc keyunbind --all
sc mouseunbind --all
sc gestureunbind --all
sc unrule

# --- essentials ------------------------------------------------------------------
# Terminal: first one installed wins. Copy this file and hardcode yours.
sc keybind $Mod-Return spawn sh -c 'for t in alacritty foot kitty wezterm konsole gnome-terminal; do command -v "$t" >/dev/null && exec "$t"; done'
sc keybind $Mod-m       launcher                          # fuzzy .desktop launcher
sc keybind Alt-Tab      spawn "$S/window-switcher.sh"     # dmenu-style window list
sc keybind $Mod-Shift-q quit
sc keybind $Mod-Shift-r reload
sc keybind $Mod-Shift-c close

# screenshots: native region select (drag, or click a window to snap), then
# annotate/copy/save in satty. Needs: grim satty (wl-clipboard for copying).
sc keybind $Mod-Shift-s spawn "$S/screenshot.sh" gui
sc keybind Print        spawn "$S/screenshot.sh" output

# media keys (PipeWire + logind tools; no extra setup)
sc keybind XF86AudioLowerVolume  spawn wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%-
sc keybind XF86AudioRaiseVolume  spawn wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+
sc keybind XF86AudioMute         spawn wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
sc keybind XF86MonBrightnessDown spawn brightnessctl set 5%-
sc keybind XF86MonBrightnessUp   spawn brightnessctl set +5%

# --- tags ------------------------------------------------------------------------
for i in 1 2 3 4 5 6 7 8 9; do
  sc keybind "$Mod-$i"       use  "$i"
  sc keybind "$Mod-Shift-$i" move "$i"
done
sc keybind $Mod-period use_index +1 --skip-visible
sc keybind $Mod-comma  use_index -1 --skip-visible
sc keybind $Mod-BackSpace cycle_monitor

# --- focus / move within the frame tree (crosses monitor edges) -------------------
for p in "Left left" "Down down" "Up up" "Right right" "h left" "j down" "k up" "l right"; do
  set -- $p
  sc keybind "$Mod-$1"       focus "$2"
  sc keybind "$Mod-Shift-$1" shift "$2"
done

# --- splits / resize / layouts ----------------------------------------------------
sc keybind $Mod-u split top  0.5
sc keybind $Mod-o split left 0.5
sc keybind $Mod-Control-space split explode
for p in "h left" "j down" "k up" "l right" "Left left" "Down down" "Up up" "Right right"; do
  set -- $p
  sc keybind "$Mod-Control-$1" resize "$2" 0.02
done
sc keybind $Mod-Control-0 set_layout vertical
sc keybind $Mod-Control-1 set_layout horizontal
sc keybind $Mod-Control-2 set_layout max
sc keybind $Mod-Control-3 set_layout grid
sc keybind $Mod-space     cycle_layout
sc keybind $Mod-r         remove
sc keybind $Mod-g         cycle
sc keybind $Mod-Tab       cycle_all +1
sc keybind $Mod-Shift-Tab cycle_all -1
sc keybind $Mod-i         jumpto urgent

# --- per-window modes --------------------------------------------------------------
sc keybind $Mod-f           fullscreen toggle
sc keybind $Mod-p           pseudotile toggle
sc keybind $Mod-Shift-space floating toggle

# --- mouse -------------------------------------------------------------------------
sc mousebind $Mod-Button1       move    # floats only; tiled windows stay put
sc mousebind $Mod-Shift-Button1 resize  # floats resize; tiled drags the splits

# --- touchpad gestures (native libinput; needs the user in the `input` group) ------
sc gesturebind swipe3-left  use_index +1 --skip-visible
sc gesturebind swipe3-right use_index -1 --skip-visible

# --- theme -------------------------------------------------------------------------
sc set window_gap 8
sc set border_width 2
sc set border_color_active '#4e9bcf'
sc set border_color_normal '#1d252b'
# sc set inactive_dim 0.07          # dim unfocused windows (0 = off)
# sc set focus_follows_mouse on

# --- night light (wlsunset, if installed) ------------------------------------------
# Coordinates come from ~/.config/sommerflusswm/weather.conf (LAT=/LON=) when
# present; without them wlsunset uses its own defaults.
if command -v wlsunset >/dev/null && ! pgrep -x wlsunset >/dev/null; then
  CONF="${XDG_CONFIG_HOME:-$HOME/.config}/sommerflusswm/weather.conf"
  [ -r "$CONF" ] && . "$CONF"
  wlsunset ${LAT:+-l $LAT} ${LON:+-L $LON} &
fi

# --- wallpaper (drawn by sfwm; the sfwm-appearance GUI browses/saves choices) -------
sc wallpaper color '#1d252b'
command -v sfwm-appearance >/dev/null && sfwm-appearance --restore &

# --- status bar (native): tags · clock/date · system tray ---------------------------
B=/usr/share/sommerflusswm/bar
sep() { sc bar add separator size=10 style=empty; }

sc bar create top height=28 marginx=8 marginy=8 bg='#f7f8f3' fg='#1d252b' font=13

# Active tag in a box, then a marker row for tags 1-9
# (# active · - visible on another monitor · ! urgent · : occupied · . empty).
sc bar add executor \
  "f(){ sc tag_status | tr '\t' '\n' | sed -n 's/^#//p'; }; f; sc --idle | while read -r _; do f; done" \
  continuous bg='#db7681' fg='#f8f7f3' pad=12
sc bar add executor \
  "f(){ sc tag_status | tr '\t' '\n' | sed -E 's/[0-9]+//' | grep . | paste -sd' '; }; f; sc --idle | while read -r _; do f; done" \
  continuous pad=8

sc bar add spacer

sc bar add executor "$B/bar-date"  interval=500
sep
sc bar add executor "$B/bar-clock" interval=60
sep
sc bar add tray size=0 spacing=6

# reserve the bar strip so tiled windows don't sit under it (height + 2*marginy)
sc pad 0 44 0 0 0
