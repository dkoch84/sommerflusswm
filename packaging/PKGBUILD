# Maintainer: the sommerflusswm authors
pkgname=sommerflusswm
pkgver=0.1.0
pkgrel=30
pkgdesc="herbstluftwm successor on river: sfwm window manager + sc control client (monitors, keybinds, frame tree, fullscreen/float/mouse/rules/borders/bar/wallpaper)"
arch=('x86_64')
url="https://github.com/dkoch84/sommerflusswm"
license=('GPL3')
# river provides the river-window-management-v1 + river-xkb-bindings-v1 protocols.
# wayland provides libwayland-client.so (dlopened); libxkbcommon resolves key names.
# libinput backs the native touchpad gestures (read directly; user in `input` group).
depends=('river' 'wayland' 'libxkbcommon' 'libinput')
makedepends=('rust' 'cargo')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    # Fetch dependencies up front so build() can run with --frozen.
    export CARGO_HOME="$srcdir/cargo-home"
    cargo fetch --locked
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR=target
    # Only the WM + control client; the GUI wallpaper browser is its own package
    # (sommerflusswm-appearance) so this one needn't pull in eframe/egui.
    cargo build --frozen --release -p sfwm -p sc
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release -p sfwm
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm755 target/release/sfwm "$pkgdir/usr/bin/sfwm"
    install -Dm755 target/release/sc   "$pkgdir/usr/bin/sc"

    # Example config: river's init and the sommerflusswm autostart (calls sc).
    install -Dm755 sfwm/examples/autostart  "$pkgdir/usr/share/sommerflusswm/autostart"
    install -Dm755 sfwm/examples/river-init  "$pkgdir/usr/share/sommerflusswm/river-init"

    # Login-screen session entry: "sfwm". The wrapper starts river with the
    # user's init if present, else the packaged river-init (which execs sfwm).
    install -Dm644 sfwm/examples/sfwm.desktop "$pkgdir/usr/share/wayland-sessions/sfwm.desktop"
    install -Dm755 sfwm/examples/sfwm-session "$pkgdir/usr/bin/sfwm-session"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
